{
  "latex-workshop.latex.recipes": [{"name": "latexmk (XeLaTeX)", "tools": ["latexmk-xelatex"]}],
  "latex-workshop.latex.tools": [{"name": "latexmk-xelatex", "command": "latexmk", "args": ["-xelatex", "-interaction=nonstopmode", "-halt-on-error", "-file-line-error", "%DOC%"]}],
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.autoBuild.run": "never"
}
